# XSO Storefront

GEMINI_API_KEY=your_google_ai_studio_key_here

# Public site URL used for Lemon redirect + receipt links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase gift storage (required in production; local dev falls back to .data/gifts.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Lemon Squeezy (leave unset to use local preview checkout → /gift/[id])
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Fallback variant for any tier without its own id below. Prices are always sent as a
# custom price computed from src/lib/pricing.ts, so variants mainly label the order.
LEMONSQUEEZY_VARIANT_ID=
# TODO: create one variant per tier in Lemon Squeezy (Single Card, Full Stack, Movie Box).
LEMONSQUEEZY_VARIANT_SINGLE=
LEMONSQUEEZY_VARIANT_FULL=
LEMONSQUEEZY_VARIANT_MOVIEBOX=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Full Stack price test ($9.99 / $14.99 / $19.99, arms in src/lib/pricing.ts). Set to 1 to enable.
NEXT_PUBLIC_PRICE_TEST=

# Recipient "Make one back" offer: a Lemon Squeezy discount code worth $5.00 off (Full Stack
# $14.99 -> $9.99), limited to the Full Stack and Movie Box variants. Leave empty to turn the offer off.
NEXT_PUBLIC_RECIPIENT_DISCOUNT_CODE=
