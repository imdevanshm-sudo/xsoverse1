# XSO Storefront

GEMINI_API_KEY=your_google_ai_studio_key_here

# Public site URL used for Lemon redirect + receipt links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase gift storage (required in production; local dev falls back to .data/gifts.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Lemon Squeezy (leave unset to use local preview checkout → /gift/[id])
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Required Lemon Squeezy product variant. Prices are always sent as a custom price from
# src/lib/pricing.ts (keepsake + any add-ons, e.g. "Our Song (Spotify)"), so this one variant
# covers every order. Add-ons need no variant of their own; they're recorded in the checkout's
# custom data (`add_ons`) and confirmed by the order_created webhook.
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Owner testing on a deployed site. With TEST_MODE=true every checkout is a Lemon test checkout
# (test cards only, so real buyers can't pay while it's on). A test order unlocks a gift only
# when the buyer's email is listed below; anyone else's test-card order is ignored. Leave both
# unset for normal sales. Lemon sends test-mode webhooks only to a webhook created in test mode.
LEMONSQUEEZY_TEST_MODE=
LEMONSQUEEZY_TEST_EMAILS=
# API key created with Lemon's Test mode switched on (live keys only make live checkouts).
# Store and variant IDs default to the live ones; set these only if Lemon gives different IDs.
LEMONSQUEEZY_TEST_API_KEY=
LEMONSQUEEZY_TEST_STORE_ID=
LEMONSQUEEZY_TEST_VARIANT_ID=
# Signing secret of the webhook created in Lemon *test mode* (same URL as the live one).
LEMONSQUEEZY_TEST_WEBHOOK_SECRET=
# While TEST_MODE is on, visitors see an "under development" page. Open any page once with
# ?tester=<this code> to unlock the store in that browser (30 days).
XSO_TESTER_CODE=

# Resend (transactional mail). Verify xsoverse.app in Resend, then set the API key.
# From address must be a verified domain sender (default: XSO <xso@xsoverse.app>).
RESEND_API_KEY=
# Optional override; defaults to XSO <xso@xsoverse.app>
# MAIL_FROM=XSO <xso@xsoverse.app>
# Reply-To / support address shown in footers (defaults to xsoverse@gmail.com)
# MAIL_REPLY_TO=xsoverse@gmail.com
